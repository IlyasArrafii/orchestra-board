{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../src/shared/*"
      ],
      "@protocol": [
        "../src/protocol.ts"
      ]
    },
    "typeRoots": [
      "../.orca/types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "types": [
      "orca",
      "orca-host",
      "orca-frame",
      "orca-services",
      "react",
      "react-dom",
      "bun"
    ]
  },
  "include": [
    "src",
    "build.ts",
    "../src/shared/model.ts",
    "../src/shared/markdown.ts",
    "../src/protocol.ts"
  ]
}
